# Optional external image-host integration.
IMGBB_API_KEY=replace-me

# Host directory tree mounted into the Notes service (read/write).
# Vault paths configured in Settings must stay inside this bind root.
VSTART2_NOTES_BIND_HOST=/Users/vbitzx

# Default Obsidian vault path used by Notes (host path).
# Can also be changed later in Settings → Widgets → Notes vault path.
VSTART2_NOTES_ROOT=/Users/vbitzx/SYNC/Vaults

# Optional native bridge overrides.
VSTART_MAILCTL_PATH=
VSTART_LIGHT_CLI_PATH=
